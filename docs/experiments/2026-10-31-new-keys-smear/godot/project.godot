; Isolated comparison fixture. Export images remain outside this Godot project.
config_version=5

[application]

config/name="Tote smear comparison - isolated experiment"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[display]

window/size/viewport_width=640
window/size/viewport_height=280
window/size/window_width_override=1280
window/size/window_height_override=560
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.055, 0.06, 0.08, 1)
